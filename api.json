{
    "openapi": "3.1.2",
    "info": {
        "title": "WHY ME",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "paths": {
        "/v1/auth/otp": {
            "post": {
                "operationId": "auth.otp",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RequestOtpRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "expires_in": {
                                                    "type": "string"
                                                },
                                                "resend_in": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "expires_in",
                                                "resend_in"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/register": {
            "post": {
                "operationId": "auth.register",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "user": {
                                                    "allOf": [
                                                        {
                                                            "$ref": "#/components/schemas/UserResource"
                                                        },
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "capabilities"
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "token": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "user",
                                                "token"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/login": {
            "post": {
                "operationId": "auth.login",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "user": {
                                                    "allOf": [
                                                        {
                                                            "$ref": "#/components/schemas/UserResource"
                                                        },
                                                        {
                                                            "type": "object",
                                                            "required": [
                                                                "capabilities"
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "token": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "user",
                                                "token"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "otp_required": {
                                                    "type": "boolean"
                                                },
                                                "expires_in": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "otp_required",
                                                "expires_in"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/password/reset": {
            "post": {
                "operationId": "auth.password.reset",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "reset": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "reset"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/config": {
            "get": {
                "operationId": "platform.config",
                "tags": [
                    "Config"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "locale": {
                                                    "type": "string"
                                                },
                                                "default_language": {
                                                    "type": "string"
                                                },
                                                "languages": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "code": {
                                                                "type": "string"
                                                            },
                                                            "name": {
                                                                "type": "string"
                                                            },
                                                            "native_name": {
                                                                "type": "string"
                                                            }
                                                        },
                                                        "required": [
                                                            "code",
                                                            "name",
                                                            "native_name"
                                                        ]
                                                    }
                                                },
                                                "min_supported_version": {
                                                    "type": "object",
                                                    "properties": {
                                                        "android": {
                                                            "type": [
                                                                "array",
                                                                "string"
                                                            ]
                                                        },
                                                        "ios": {
                                                            "type": [
                                                                "array",
                                                                "string"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "android",
                                                        "ios"
                                                    ]
                                                },
                                                "features": {
                                                    "type": "string"
                                                },
                                                "settings": {
                                                    "type": "string"
                                                },
                                                "server_time": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "locale",
                                                "default_language",
                                                "languages",
                                                "min_supported_version",
                                                "features",
                                                "settings",
                                                "server_time"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/health": {
            "get": {
                "operationId": "platform.health",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "time": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "time"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "degraded"
                                        },
                                        "time": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "time"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/me": {
            "get": {
                "operationId": "me.show",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "capabilities"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "patch": {
                "operationId": "me.update",
                "tags": [
                    "Me"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "capabilities"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/me/capabilities": {
            "post": {
                "operationId": "me.capabilities.store",
                "tags": [
                    "Me"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ActivateCapabilityRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ActivateCapabilityRequest": {
                "type": "object",
                "properties": {
                    "capability": {
                        "$ref": "#/components/schemas/Capability"
                    },
                    "terms_version_id": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    }
                },
                "required": [
                    "capability"
                ],
                "title": "ActivateCapabilityRequest"
            },
            "Capability": {
                "type": "string",
                "description": "Selling, service and employer features are added to the one account (ACC01, ACC07). Buying, requesting services and applying need no capability.\n",
                "enum": [
                    "vendor",
                    "provider",
                    "employer",
                    "job_seeker"
                ],
                "title": "Capability"
            },
            "CapabilityResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "capability": {
                        "type": "string",
                        "enum": [
                            "vendor",
                            "provider",
                            "employer",
                            "job_seeker"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "active",
                            "suspended"
                        ]
                    },
                    "verification_state": {
                        "type": "string",
                        "enum": [
                            "unverified",
                            "pending",
                            "verified",
                            "rejected"
                        ]
                    },
                    "activated_at": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "capability",
                    "status",
                    "verification_state",
                    "activated_at"
                ],
                "title": "CapabilityResource"
            },
            "DevicePlatform": {
                "type": "string",
                "enum": [
                    "android",
                    "ios",
                    "web"
                ],
                "title": "DevicePlatform"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "pattern": "^\\+234\\d{10}$"
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "device": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 8,
                                "maxLength": 64
                            },
                            "platform": {
                                "$ref": "#/components/schemas/DevicePlatform"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 100
                            },
                            "app_version": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 20
                            }
                        },
                        "required": [
                            "id",
                            "platform"
                        ]
                    }
                },
                "required": [
                    "phone",
                    "password",
                    "device"
                ],
                "title": "LoginRequest"
            },
            "OtpPurpose": {
                "type": "string",
                "enum": [
                    "register",
                    "reset_password",
                    "new_device"
                ],
                "title": "OtpPurpose"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 120
                    },
                    "phone": {
                        "type": "string",
                        "pattern": "^\\+234\\d{10}$"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                    },
                    "code": {
                        "type": "string"
                    },
                    "device": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 8,
                                "maxLength": 64
                            },
                            "platform": {
                                "$ref": "#/components/schemas/DevicePlatform"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 100
                            },
                            "app_version": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 20
                            }
                        },
                        "required": [
                            "id",
                            "platform"
                        ]
                    }
                },
                "required": [
                    "name",
                    "phone",
                    "password",
                    "code",
                    "device"
                ],
                "title": "RegisterRequest"
            },
            "RequestOtpRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "pattern": "^\\+234\\d{10}$"
                    },
                    "purpose": {
                        "$ref": "#/components/schemas/OtpPurpose"
                    }
                },
                "required": [
                    "phone",
                    "purpose"
                ],
                "title": "RequestOtpRequest"
            },
            "ResetPasswordRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "pattern": "^\\+234\\d{10}$"
                    },
                    "code": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 128
                    }
                },
                "required": [
                    "phone",
                    "code",
                    "password"
                ],
                "title": "ResetPasswordRequest"
            },
            "UpdateProfileRequest": {
                "type": "object",
                "properties": {
                    "version": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 120
                    },
                    "locale": {
                        "type": "string",
                        "enum": [
                            "en",
                            "ig"
                        ]
                    }
                },
                "required": [
                    "version"
                ],
                "title": "UpdateProfileRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "locale": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "active",
                            "suspended"
                        ]
                    },
                    "version": {
                        "type": "integer"
                    },
                    "phone_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "capabilities": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CapabilityResource"
                        }
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "phone",
                    "email",
                    "locale",
                    "status",
                    "version",
                    "phone_verified_at",
                    "created_at"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}